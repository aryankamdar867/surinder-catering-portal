# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# ---------------------------------------------------------------------------
# Frontend (bundled into the browser – Vite only exposes variables prefixed VITE_)
# Only PUBLIC values belong here. The publishable key is safe to expose because
# every table is protected by Row Level Security.
# Supabase Dashboard → Project Settings → API Keys → "Publishable key"
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://drgmqxrniqrusvagktpw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Server-only (Vercel serverless functions in /api – NEVER prefix with VITE_)
# Set these in Vercel → Project Settings → Environment Variables.
# ---------------------------------------------------------------------------
# Used ONLY by api/menu-suggestions.js to refund a customer's suggestion slot when the AI
# provider fails. Never prefix it with VITE_ (that would ship it to the browser).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
# Claude API key for AI menu suggestions (api/menu-suggestions.js). For local dev,
# put it in .env.local; the dev server passes it to /api only, never to the browser.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
# Optional: overall time limit for the AI call in ms (default and maximum 45000).
# MENU_SUGGESTIONS_AI_TIMEOUT_MS=45000
